// MainActivity.kt

import android.Manifest
import android.content.pm.PackageManager
import android.os.Bundle
import android.widget.Button
import android.widget.TextView
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AppCompatActivity
import androidx.core.content.ContextCompat
import com.google.api.gax.rpc.ClientStream
import com.google.cloud.speech.v1.StreamingRecognizeRequest
import java.lang.StringBuilder

class MainActivity : AppCompatActivity() {

    private lateinit var transcriptTextView: TextView
    private lateinit var toggleButton: Button
    
    // ⭐️ Google Cloud API Key를 여기에 설정하세요. 
    // 실제 사용 시에는 보안을 위해 서버에서 관리해야 합니다.
    private val API_KEY = "YOUR_GOOGLE_CLOUD_API_KEY" 
    
    private val manager by lazy { SpeechRecognitionManager(API_KEY) }
    private var clientStream: ClientStream<StreamingRecognizeRequest>? = null
    private var audioRecorder: AudioRecorder? = null

    private val speakerMap = mutableMapOf<Int, String>()
    private var currentSpeaker = 0 
    private var nextSpeakerIndex = 1 
    private val conversationBuilder = StringBuilder() // 대화 내용을 누적

    // 권한 요청 런처
    private val requestPermissionLauncher = 
        registerForActivityResult(ActivityResultContracts.RequestPermission()) { isGranted: Boolean ->
            if (isGranted) {
                startRecording()
            } else {
                transcriptTextView.text = "마이크 권한이 필요합니다."
            }
        }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        // 레이아웃 초기화 (TextView와 Button이 있다고 가정)
        // setContentView(R.layout.activity_main) 
        // transcriptTextView = findViewById(R.id.transcriptTextView)
        // toggleButton = findViewById(R.id.toggleButton)
        
        // 예시를 위해 임시로 TextView와 Button을 설정했다고 가정합니다.
        transcriptTextView = TextView(this)
        toggleButton = Button(this).apply { text = "녹음 시작" }
        setContentView(transcriptTextView) // 실제로는 레이아웃을 사용해야 합니다.

        toggleButton.setOnClickListener {
            if (clientStream != null) {
                stopRecording()
            } else {
                checkPermissionAndStart()
            }
        }
    }

    private fun checkPermissionAndStart() {
        if (ContextCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) 
            != PackageManager.PERMISSION_GRANTED) {
            requestPermissionLauncher.launch(Manifest.permission.RECORD_AUDIO)
        } else {
            startRecording()
        }
    }

    private fun startRecording() {
        // 1. STT 스트림 시작
        clientStream = manager.startStreamingRecognition(
            onResult = ::handleRecognitionResult,
            onError = { t -> 
                runOnUiThread {
                    transcriptTextView.text = "오류 발생: ${t.message}"
                    stopRecording(false) // 오류 발생 시 강제 중지 (UI만)
                }
            }
        )

        // 2. 오디오 레코더 시작 (데이터 전송 시작)
        clientStream?.let {
            audioRecorder = AudioRecorder(manager, it)
            audioRecorder?.startRecording()
            toggleButton.text = "녹음 중지"
            conversationBuilder.clear()
            transcriptTextView.text = "말씀하세요..."
        }
    }

    private fun stopRecording(stopStream: Boolean = true) {
        audioRecorder?.stopRecording()
        audioRecorder = null
        
        if (stopStream) {
            clientStream?.let { manager.stopRecognition(it) }
        }
        clientStream = null
        toggleButton.text = "녹음 시작"
        currentSpeaker = 0 // 화자 상태 초기화
        speakerMap.clear()
        nextSpeakerIndex = 1
    }

    // 화자 태그(1, 2, 3...)를 A, B, C...로 변환하는 로직 (담백한 변환)
    private fun getSpeakerName(tag: Int): String {
        if (tag == 0) return "" // 태그가 없는 경우 (초기 또는 오류)
        if (tag !in speakerMap) {
            speakerMap[tag] = when (nextSpeakerIndex) {
                1 -> "A"
                2 -> "B"
                else -> "화자 ${nextSpeakerIndex - 1}" // C 이후에는 번호 사용
            }
            nextSpeakerIndex++
        }
        return speakerMap[tag]!!
    }

    private fun handleRecognitionResult(result: SpeakerResult) {
        // UI 업데이트는 메인 쓰레드에서 실행
        runOnUiThread {
            val speakerName = getSpeakerName(result.speakerTag)
            
            // ⭐️ 화자 변경 또는 최종 결과 확정 시 줄 바꿈 및 이름 추가
            if (result.speakerTag != currentSpeaker && result.speakerTag != 0) {
                if (currentSpeaker != 0) {
                    conversationBuilder.append("\n\n") // 이전 화자와 구분
                }
                conversationBuilder.append("$speakerName: ")
                currentSpeaker = result.speakerTag
            }
            
            // 최종 텍스트만 업데이트 (담백하게)
            // 임시 결과는 최종 텍스트를 대체하고, 최종 결과는 빌더에 추가
            
            // 마지막 줄만 임시 결과로 갱신하여 실시간성을 확보 (놓치지 않음)
            val lines = conversationBuilder.toString().lines().toMutableList()
            val lastLineIndex = lines.lastIndex
            
            val newLastLine = if (result.speakerTag != 0) {
                "$speakerName: ${result.transcript}"
            } else {
                result.transcript
            }
            
            if (lastLineIndex >= 0) {
                 // 마지막 줄 갱신
                lines[lastLineIndex] = newLastLine
            } else {
                lines.add(newLastLine)
            }
            
            val updatedText = lines.joinToString("\n")
            transcriptTextView.text = updatedText
            
            if (result.isFinal) {
                // 최종 결과가 확정되면, 빌더에 최종 텍스트를 확정하여 추가합니다.
                conversationBuilder.clear().append(updatedText)
            }
        }
    }
}
